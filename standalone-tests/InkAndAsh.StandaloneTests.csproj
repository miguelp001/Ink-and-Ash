<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <DefineConstants>STANDALONE_TEST</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Assets\Scripts\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <Compile Include="..\Assets\Scripts\Core\Events\*.cs" Link="Core\Events\%(Filename)%(Extension)" />
    <Compile Include="..\Assets\Scripts\Data\*.cs" Link="Data\%(Filename)%(Extension)" />
    <Compile Include="..\Assets\Scripts\Combat\*.cs" Link="Combat\%(Filename)%(Extension)" />
    <Compile Include="..\Assets\Scripts\Economy\*.cs" Link="Economy\%(Filename)%(Extension)" />
    <Compile Include="..\Assets\Scripts\World\*.cs" Link="World\%(Filename)%(Extension)" />
    <Compile Include="..\Assets\Scripts\Narrative\*.cs" Link="Narrative\%(Filename)%(Extension)" />
    <Compile Include="..\Assets\Tests\EditMode\*.cs" Link="EditModeTests\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Milestone2AdversarialStressTests.cs" />
    <Compile Remove="..\Assets\Scripts\Core\PlayerController.cs" />
    <Compile Remove="..\Assets\Scripts\Combat\RestorativeCombatController.cs" />
    <Compile Remove="..\Assets\Tests\EditMode\ProloguePhase8Tests.cs" />
  </ItemGroup>
</Project>
