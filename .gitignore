# Unity standard ignore
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/

# Asset meta data should only be ignored if the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Visual Studio / Rider / IDE cache
.vs/
.idea/
.gradle/
ExportedObj/
.consulo/
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Solution and project files generated by Unity at root
/*.csproj
/*.unityproj
/*.sln
/*.suo
/*.tmp
!standalone-tests/**/*.csproj

# .NET test build outputs
standalone-tests/bin/
standalone-tests/obj/
standalone-tests/TestResults/
[Tt]est[Rr]esults/

# Crash dumps and diagnostic output
sysinfo.txt
crash*.dmp

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Builds
*.apk
*.aab
*.unitypackage
*.app

# OS generated
.DS_Store
Thumbs.db
